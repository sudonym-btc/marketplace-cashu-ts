{
  "name": "@sudonym-btc/marketplace-cashu",
  "version": "0.1.0",
  "description": "Nostr-agnostic Cashu escrow policy implementation for marketplace payments.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudonym-btc/marketplace-cashu-ts.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./marketplace": {
      "types": "./dist/marketplace/index.d.ts",
      "import": "./dist/marketplace/index.js"
    },
    "./escrow": {
      "types": "./dist/escrow/index.d.ts",
      "import": "./dist/escrow/index.js"
    },
    "./auction": {
      "types": "./dist/auction/index.d.ts",
      "import": "./dist/auction/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "docs": "npm run docs:api",
    "docs:api": "nmdk-typedoc --plugin typedoc-plugin-markdown --tsconfig tsconfig.json --name \"Marketplace Cashu Driver\" --out docs/reference --readme none --githubPages false --hideBreadcrumbs true --hidePageHeader true --disableSources src/index.ts",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@sudonym-btc/marketplace-driver-interface": "0.1.0",
    "@cashu/cashu-ts": "^4.10.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@sudonym-btc/nmdk-typescript-tooling": "0.1.0"
  },
  "engines": {
    "node": ">=22.4"
  }
}
